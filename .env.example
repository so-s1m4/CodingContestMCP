# Server settings only. Each client supplies X-CCC-Session on HTTP requests.
# CCC_SESSION, CCC_COOKIE and MCP_ACCESS_TOKEN from the environment are ignored.
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PUBLIC_ORIGIN=http://localhost:8000
CCC_DATA_DIR=./data
CCC_TIMEOUT=30
CCC_MAX_FILE_BYTES=67108864
CCC_ENABLE_RAW_WRITES=0
BOT_TOKEN=
BOT_CHAT_ID=
# Optional override; the default is $CCC_DATA_DIR/telegram-sent.sqlite3.
# BOT_DEDUPE_DB=/absolute/path/telegram-sent.sqlite3
# Streamable HTTP at /mcp. Public deployments require HTTPS.
